{
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  },
  "typescript.tsdk": ".yarn/sdks/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "cSpell.words": [
    "biome",
    "contexts",
    "correctness",
    "couldn’t",
    "creating",
    "determine",
    "Divider",
    "Drawer",
    "gatsby",
    "getting",
    "Gutters",
    "icons",
    "logo",
    "Night",
    "outlined",
    "pages",
    "Palette",
    "Prefers",
    "Props",
    "Rounded",
    "Sorry",
    "started",
    "Styled",
    "Sunny",
    "Theme",
    "there",
    "Typography"
  ]
}
