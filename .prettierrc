{
  "tabWidth": 2,
  "overrides": [
    {
      "files": "*.yml",
      "options": {
        "semi": false,
        "singleQuote": true
      }
    },
    {
      "files": "*.md",
      "options": {
        "parser": "markdown",
        "useTabs": false
      }
    },
    {
      "files": "*.ts",
      "options": {
        "singleQuote": true,
        "printWidth": 120,
        "trailingComma": "all",
        "arrowParens": "always",
        "semi": false
      }
    },
    {
      "files": "*.tsx",
      "options": {
        "singleQuote": true,
        "printWidth": 120,
        "trailingComma": "all",
        "arrowParens": "always",
        "semi": false
      }
    },
    {
      "files": "*.js",
      "options": {
        "singleQuote": true,
        "printWidth": 120,
        "trailingComma": "all",
        "arrowParens": "always",
        "semi": false
      }
    }
  ],
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "useTabs": false
}
